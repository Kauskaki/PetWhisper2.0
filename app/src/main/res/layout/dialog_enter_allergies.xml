<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitleA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/baloo_bhai"
        android:text="Add Allergy"

        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/editAllergyName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_corners_stroke_n_purp"
        android:fontFamily="@font/baloo_bhai"
        android:hint="Enter Allergy"
        android:padding="10dp"
        android:textColor="@color/oceanBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogTitleA" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editAllergyNotes"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/buttonCancelAllergy"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/linearlayout_seafoam_bg"
            android:fontFamily="@font/baloo_bhai"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Cancel"
            android:textAlignment="center"
            android:textColor="@color/dullPurp" />

        <ImageView
            android:id="@+id/trash_allergy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/trashpurp_ic"
            android:clickable="true" />


        <TextView
            android:id="@+id/buttonSaveAllergy"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/linearlayout_bg"
            android:fontFamily="@font/baloo_bhai"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/save"
            android:textAlignment="center"
            android:textColor="@color/dullPurp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editAllergyNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/round_corners_pastelyellow"
        android:fontFamily="@font/baloo_bhai"
        android:gravity="top"
        android:hint="Notes . . . "
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:maxLines="12"
        android:minLines="6"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="5dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editAllergyName" />

</androidx.constraintlayout.widget.ConstraintLayout>