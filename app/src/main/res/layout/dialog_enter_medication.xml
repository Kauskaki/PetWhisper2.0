<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitleV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/baloo_bhai"
        android:text="Add Medication"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/editMedicationName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/rounded_corners_stroke_n_purp"
        android:hint="Enter Medication Name"
        android:padding="10dp"
        android:textColor="@color/oceanBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogTitleV" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/medicationExpirationDate">

        <TextView
            android:id="@+id/buttonCancelMeds"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="25dp"
            android:background="@drawable/linearlayout_seafoam_bg"
            android:fontFamily="@font/baloo_bhai"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Cancel"
            android:textAlignment="center"
            android:textColor="@color/dullPurp" />

        <ImageView
            android:id="@+id/trash_meds"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/trashpurp_ic"
            android:clickable="true" />

        <TextView
            android:id="@+id/buttonSaveMedication"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:background="@drawable/linearlayout_bg"
            android:fontFamily="@font/baloo_bhai"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/save"
            android:textAlignment="center"
            android:textColor="@color/dullPurp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/constraintLayout6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/linearlayout_seafoam_bg"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editMedicationName">

        <Spinner
            android:id="@+id/medicineType_spinner"
            android:layout_width="109dp"
            android:layout_height="45dp"
            android:layout_marginStart="15dp"
            android:popupBackground="@drawable/edit_text_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <EditText
            android:id="@+id/editMedicationDosage"
            android:layout_width="174dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:hint="Enter Dosage"
            android:padding="10dp"
            android:textColor="@color/oceanBlue"
            app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>

    <EditText
        android:id="@+id/editMedicationNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/round_corners_pastelyellow"
        android:fontFamily="@font/baloo_bhai"
        android:gravity="top"
        android:hint="Instructions"
        android:inputType="textMultiLine"
        android:maxLines="10"
        android:minLines="6"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="5dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout6" />

    <LinearLayout
        android:id="@+id/medicationExpirationDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_rounded2"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editMedicationNotes">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo_bhai"
            android:text="Expiration Date:"
            android:textAlignment="center"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/expirationDatePicker_meds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/baloo_bhai"
            android:text="01/01/2025"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>