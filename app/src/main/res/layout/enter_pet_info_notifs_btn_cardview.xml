<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_notif_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        android:clickable="true"
        app:cardElevation="7dp"
        android:focusable="true"
        android:contextClickable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/linearlayout_seafoam_bg">

            <ImageView
                android:id="@+id/notif_image"
                android:layout_width="56dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:contentDescription="@string/notif_cover"
                android:src="@drawable/food_ic" />

            <TextView
                android:id="@id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#F7CFD8"
                android:fontFamily="@font/baloo_bhai"
                android:paddingBottom="5dp"
                android:text="Mealtime"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="15sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>