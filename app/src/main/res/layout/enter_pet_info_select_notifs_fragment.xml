<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".petinfo.FragmentSelectPetNotifications">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_corner_nostroke"
        android:paddingBottom="90dp">


        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:background="@drawable/round_corners_pastelyellow"
            android:fontFamily="@font/baloo_bhai"
            android:padding="12dp"
            android:text="Select Notification type"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/linearLayout_SelectNotifs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView11">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_SelectNotifs"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout_SelectNotifs">


            <!-- Collapsible Content -->

            <TextView
                android:id="@+id/header_premise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_corners_pastelyellow"
                android:fontFamily="@font/baloo_bhai"
                android:padding="12dp"
                android:text="Notifications"
                android:textSize="20sp" />

            <ExpandableListView
                android:id="@+id/content_Notif_sections"
                android:layout_width="match_parent"
                android:layout_height="354dp"
                android:background="@drawable/rounded_search_bg"
                android:groupIndicator="@null"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="visible">

            </ExpandableListView>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/Save_in_notifs"
            android:layout_width="wrap_content"
            android:layout_height="58dp"
            android:background="@drawable/linearlayout_bg"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="15dp"
                android:background="@drawable/save_ic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="15dp"
                android:fontFamily="@font/baloo_bhai"
                android:text="Save"
                android:textSize="25sp" />


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>