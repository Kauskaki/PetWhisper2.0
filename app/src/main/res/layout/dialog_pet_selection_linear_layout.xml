<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@drawable/round_corner_nostroke">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shapeablePetic"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:src="@drawable/food_ic"
         />

    <TextView
        android:id="@+id/itemText"
        android:textColor="@color/pastelYellow"
        android:layout_width="205dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/baloo_bhai"
        android:gravity="center"
        android:text="@string/testpet"
        android:textAlignment="center"
        android:textAppearance="@color/azure"
        android:textSize="18sp" />
</LinearLayout>