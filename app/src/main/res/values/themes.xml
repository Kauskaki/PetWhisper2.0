<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PetWhisper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>



    </style>


    <style name="RoundedImage">
        <item name="cornerSize">50%</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/black</item>
    </style>


    <style name="Theme.PetWhisper" parent="Base.Theme.PetWhisper" />

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="FloatingActionButtonStyle" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="android:backgroundTint">@color/DarkPurp</item>
        <item name ="strokeWidth">2dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="cornerSize">60%</item>

    </style>

    <string name="Round_radius">
        <item name="cornerSize">25%</item>
    </string>
    <style name="DialogStyle" parent="Theme.AppCompat.Dialog">
        <item name= "android:windowMinWidthMajor"> 80%</item>
        <item name= "android:windowMinWidthMinor"> 80%</item>


    </style>



</resources>